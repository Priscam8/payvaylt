{
  "cli": {
    "version": ">= 16.13.3",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_PAYVAYLT_API_URL": "https://payvaylt-api.onrender.com/api",
        "PAYVAYLT_PUBLIC_APP_URL": "https://payvaylt-app.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
